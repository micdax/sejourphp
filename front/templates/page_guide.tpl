<main id="content" class="site-main guide-page">
    {__guide_hero_html}

    <section class="guide-introduction-section">
        <div class="container">
            <div class="guide-introduction-layout">
                <div class="guide-introduction-content {__guide_intro_class}">
                    {__guide_intro_html}
                </div>
                <aside class="guide-sidebar">
                    <section class="guide-island-list {__guide_list_class}">
                        <h2>{__guide_list_title}</h2>
                        <ul>{__guide_list_html}</ul>
                    </section>
                    <div class="node-sidebar-promotions {__guide_promotions_class}">
                        {__guide_promotions_html}
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <section class="guide-islands-section {__guide_cards_class}">
        <div class="container">
            <header class="guide-section-heading"><h2>{__guide_cards_title}</h2></header>
            <div class="guide-island-cards">{__guide_cards_html}</div>
        </div>
    </section>

    <section class="guide-contents-section {__guide_contents_class}">
        <div class="container">
            <header class="guide-section-heading writer"><h2>{__guide_contents_title}</h2></header>
            <div class="guide-content-cards">{__guide_contents_html}</div>
        </div>
    </section>
    <section class="guide-empty-section {__guide_empty_class}">
        <div class="container"><p>{__guide_empty}</p></div>
    </section>
</main>
