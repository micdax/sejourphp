<article class="guide-content-card reveal-up reveal-closer" id="contenu-{__guide_content_id}">
    <a class="guide-content-card-link" href="{__guide_content_url}"
       aria-label="{__guide_content_discover} — {__guide_content_title_plain}">
        <figure class="guide-content-card-image">
            <img src="{__guide_content_image}" alt="{__guide_content_title_plain}" loading="lazy">
            <span class="guide-content-card-information {__guide_content_information_class}">{__guide_content_information}</span>
        </figure>
        <span class="guide-content-card-body">
            <strong class="guide-content-card-title">{__guide_content_title}</strong>
            <span class="guide-content-card-description {__guide_content_description_class}">{__guide_content_description}</span>
        </span>
    </a>
    <div class="guide-content-card-actions">
        <button class="selection-toggle article-selection-toggle {__guide_content_selection_class}" type="button"
                data-article-id="{__guide_content_id}" data-article-url="{__guide_content_url}"
                data-add-label="{__guide_content_selection_add}" data-remove-label="{__guide_content_selection_remove}"
                data-added-message="{__guide_content_selection_added}" data-removed-message="{__guide_content_selection_removed}"
                data-selection-tooltip="{__guide_content_selection_tooltip}"
                data-selected-tooltip="{__guide_content_selection_tooltip_selected}"
                data-unselected-tooltip="{__guide_content_selection_tooltip_unselected}"
                aria-pressed="{__guide_content_selection_pressed}" aria-label="{__guide_content_selection_action}">
            <span>{__guide_content_selection_label}</span>
            <i class="{__guide_content_selection_icon} fa-heart" aria-hidden="true"></i>
        </button>
    </div>
</article>
